# Copy this file to .env and adjust as needed.

# Express server
PORT=3010
JWT_SECRET=change-this-secret-key

# MySQL (XAMPP defaults: root with no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=intramsgrado_db

# Public origin allowed for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5174