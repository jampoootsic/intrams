# Copy to repo-root .env (dotenv loads from the cwd) and adjust as needed.
# Not needed under devenv (devenv.nix sets these).

# Express server
PORT=3010
JWT_SECRET=change-this-secret-key

# Postgres connection string (local or Neon pooled URL with ?sslmode=require)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/intramsgrado_db

# Set on Vercel to store candidate photos in Vercel Blob; unset = server/uploads on disk
# BLOB_READ_WRITE_TOKEN=

# Extra origin allowed for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5174
